    <Variables>
      <variableNames type="QStringList">
        <value>CSS</value>
        <value>Color1</value>
        <value>Color2</value>
        <value>Feat2Html</value>
        <value>Font</value>
      </variableNames>
      <variableValues type="QStringList">
        <value>* { direction: rtl; font-family: [% @Font %];} h1 { font-size:20px; text-align:center; letter-spacing:2.5px;font-weight:bold;} h2{ font-size:20px; text-align:center;} p { font-size:12px; text-align:center;}  .sub{ font-size:12px;font-weight:light; text-align:right;color:dimgray;} h2 {display:inherit;} div.mapTip{display:block;min-height:300px;min-width:200px;overflow:scroll;border-radius:10px;}</value>
        <value>#FF3D3D</value>
        <value>#948FBA</value>
        <value>with_variable( 'Att'
	,attributes()
	,
	-- Setting header 
	coalesce('&lt;h1 style="color:Dimgray;">' ||map_get(@Att,@HeaderField) ||'&lt;/h1>','')
	|| '&lt;table style="text-align:center; color:dimgray;">
		&lt;colgroup>
			&lt;col style="background-color:pink">
			&lt;col style="background-color:white;">
		&lt;/colgroup>'||
	-- Setting top fields
	if(coalesce(@TopFields,@LinkFields,'ERROR') &lt;> 'ERROR'
		,coalesce('&lt;thead>' || array_to_string(
				array_foreach(
					string_to_array(@LinkFields,',')
					,'&lt;tr>&lt;td colspan="2" style="color:black;">&lt;b>&lt;a href="' || map_get(@Att,@element) || '">'||coalesce(eval('C_GetAlias(@layer,@element)'),@element)||'&lt;/a>&lt;/b>&lt;/td>&lt;/tr>'
				)
			),'')
		|| coalesce( array_to_string(
			array_foreach(
				string_to_array(@TopFields,',')
				,'&lt;tr>&lt;td style="color:black;">&lt;b>' || coalesce(eval('C_GetAlias(@layer,@element)'),@element) || ': &lt;/b>&lt;/td>&lt;td>' || map_get(@Att,@element) ||'&lt;/td>&lt;/tr>'
			)
		),'')
		
		||'&lt;/thead>'
		,''
	) || '&lt;tbody class="sub" style="text-align:center;">'||
	-- Setting all other fields except images
	if(coalesce(@HideFields,'ERROR') &lt;> '*' 
		,with_variable('Hide'
			,string_to_array(concat(
				coalesce(@HeaderField||',','')
				,coalesce(@TopFields||',','')
				,coalesce(@ImageFields||',','')
				,coalesce(@LinkFields||',','')
				,coalesce(@HideFields,'')
			),',')
			,array_to_string(array_foreach( 
				map_akeys(@Att)
				,if(not array_contains(@Hide,@element)
					,'&lt;tr>&lt;td style="color:black;">' || coalesce(eval('C_GetAlias(@layer,@element)'),@element) || ': &lt;/td>&lt;td>' 
					|| map_get(@Att,@element) ||'&lt;/td>&lt;/tr>'
					,''
				)
			),'')
		)
		,' '
	)
	||'&lt;/tbody>'||
	-- Adding images
	if( array_contains(map_akeys(@Att),array_get(string_to_array(@ImageFields),0))
		,'&lt;tfoot>' ||array_to_string(
			array_foreach(
				string_to_array(@ImageFields)
				,'&lt;br>&lt;b>'||@element||': &lt;/b>&lt;img src="'|| map_get(@Att,@element) ||'" alt="'||coalesce(eval('C_GetAlias(@layer,@element)'),@element) ||'">'
			)
			,' '
		) ||'&lt;/tfoot>'
		,''
	)
)||'&lt;/table>'</value>
        <value>Rubik</value>
      </variableValues>
    </Variables>
