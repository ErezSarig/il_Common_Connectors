      <attributeactions>
        <defaultAction value="{0f90e5a3-87a6-44af-a7ee-57d2f3bed635}" key="Canvas"/>
        <actionsetting action="import requests&#xa;import json&#xa;&#xa;import PyQt5&#xa;from PyQt5.QtWidgets import QApplication, QWidget,QDialog,QPushButton,QVBoxLayout,QLabel,QComboBox,QGroupBox&#xa;from PyQt5.QtGui import QFont&#xa;from PyQt5.QtCore import Qt&#xa;&#xa;import sys&#xa;import os&#xa;import platform&#xa;import subprocess&#xa;&#xa;&#xa;## Get URLs&#xa;URL = 'https://apps.land.gov.il/TabaSearch/api//SerachPlans/GetPlans'&#xa;Header= {&#xa;    'Content-Type': 'application/json'&#xa;}&#xa;&#xa;D = {&#xa;    'planNumber':''&#xa;    ,'gush':&quot;[%GUSH_NUM%]&quot;&#xa;    ,'chelka':&quot;[%PARCEL%]&quot;&#xa;}&#xa;Data = json.dumps(D)&#xa;print('Data: ',Data) ##^&#xa;Suffix = 'https://apps.land.gov.il'&#xa;Response = requests.post(URL,data=Data,headers=Header)&#xa;&#xa;PlansName = dict()&#xa;try:&#xa;    J = json.loads(Response.text)['plansSmall']&#xa;    for P in J:&#xa;        ## Sorts all plans by their order&#xa;        PlansName[P['planNumber']] = P&#xa;        &#xa;except Exception as Err:&#xa;    print(Response)&#xa;    print('Probably no plan page on mmmi. Exception: ',Err)&#xa;    PlansName['לא נמצאו תכניות לחלקה זו']=0&#xa;    &#xa;class ChooseDoc(QDialog):&#xa;    ''' A dialog for choosing documents '''&#xa;    def __init__(self,Parent= None): ## Make iface parent?&#xa;        super(ChooseDoc,self).__init__(Parent)&#xa;        self.setWindowTitle('מסמכי תכניות מרמ״י')&#xa;        Font = QFont('[%coalesce(@Font,'sans-serif')%]')&#xa;        self.setFont(Font)&#xa;        self.Lay = QVBoxLayout(self)&#xa;        #Logo ='&lt;a href=&quot;https://github.com/ErezSarig&quot;>Common Ground&lt;/a>'&#xa;        Label = '&lt;h2> חלקה [%PARCEL%] &lt;/h2>בגוש  [%GUSH_NUM%]'&#xa;        self.Lay.addWidget(QLabel(Label))&#xa;        self.Select = QComboBox()&#xa;        self.Select.insertItems(0,list(PlansName.keys()))&#xa;        self.Lay.addWidget(self.Select)&#xa;        self.Select.currentIndexChanged.connect(self.PlanSelected)&#xa;        self.Buttons = QGroupBox()&#xa;        self.GroupLayout = QVBoxLayout(self.Buttons)&#xa;        self.Buttons.setLayout(self.GroupLayout)&#xa;        self.Lay.addWidget(self.Buttons)&#xa;        &#xa;        Link = QLabel('&lt;a style=&quot;font-size:9px;&quot; href=&quot;https://github.com/ErezSarig&quot;> מ צ ו י&lt;br>&lt;span style=&quot;text-decoration:none&quot;> בסביבה&lt;/span>&lt;/a>')&#xa;        Link.setOpenExternalLinks(True)&#xa;        self.Lay.addWidget(Link,Qt.AlignLeft)&#xa;        if PlansName[list(PlansName.keys())[0]] !=0:&#xa;            self.PlanSelected()&#xa;    &#xa;    def PlanSelected(self):&#xa;        Current = self.GroupLayout.takeAt(0)&#xa;        while Current != None : ##Going through all widgets in layout to delete them&#xa;            Current.widget().setParent(None)&#xa;            Current = self.GroupLayout.takeAt(0)&#xa;        &#xa;        print('Presented text: ',self.Select.currentText())&#xa;        ##Getting all links for this plan&#xa;        AllLinks = list()&#xa;        SelectedPlan = PlansName[self.Select.currentText()]['documentsSet']&#xa;        #print(SelectedPlan) ##^&#xa;        for Line in SelectedPlan.keys():&#xa;            #print('Link?: ',Line,type(Line)) ##^&#xa;            if type(SelectedPlan[Line]).__name__ == 'dict' and 'path' in SelectedPlan[Line].keys():&#xa;                AllLinks.append((SelectedPlan[Line]['path'],SelectedPlan[Line]['info']))&#xa;            elif type(SelectedPlan[Line]).__name__ == 'list':&#xa;                for L in SelectedPlan[Line]:&#xa;                    if type(L).__name__ == 'dict' and 'path' in L.keys():&#xa;                        AllLinks.append(([L['path'],L['info']])) &#xa;&#xa;        self.GroupLayout.addWidget(QLabel('&lt;h3> מסמכי התכנית:&lt;/h3>'))&#xa;        ## Setting all links as buttons&#xa;        for Link in AllLinks:&#xa;            B = QPushButton(Link[1])&#xa;            if Link[0] !=None and Link[0][0] in ('/','\\'):&#xa;                FullLink = Suffix+Link[0].replace('\\','/')&#xa;            else:&#xa;                FullLink = Link[0]&#xa;            B.setProperty('Link',FullLink)&#xa;            B.clicked.connect(self.OpenLink)&#xa;            self.GroupLayout.addWidget(B)&#xa;            #print(B)&#xa;            if Link[0] == None:&#xa;                B.setEnabled(False)&#xa;         &#xa;    def OpenLink(self):&#xa;        print('Sent to link: ',self.sender().property('Link'))&#xa;        filepath =self.sender().property('Link')&#xa;        if platform.system() == 'Windows':&#xa;            os.startfile(filepath)&#xa;        elif platform.system() == 'Darwin':  # macOS&#xa;            subprocess.run(['open', filepath])&#xa;        else:  # Linux&#xa;            subprocess.run(['xdg-open', filepath])&#xa;&#xa;B= ChooseDoc()&#xa;B.exec()" isEnabledOnlyWhenEditable="0" notificationMessage="" id="{0f90e5a3-87a6-44af-a7ee-57d2f3bed635}" shortTitle="" capture="0" name="הצג תכניות ומסמכים" type="1" icon="">
          <actionScope id="Feature"/>
          <actionScope id="Canvas"/>
        </actionsetting>
      </attributeactions>
